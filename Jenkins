
pipeline {
    agent any
    environment{
       scannerHome = tool 'mysonar';
    }
    
    stages {
        stage('Clean Ws') {
            steps {
                cleanWs()
            }
        }
        stage("code"){
            steps{
                git "https://github.com/saluvalasaichandu/k8s-project-source-code.git"
            }
        }
        stage("CQA"){
            steps{
                withSonarQubeEnv('mysonar') {
                    sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=EKS-Blood-bank-app"
                    }
            }
        }
        stage("Quality-Gates"){
            steps{
                waitForQualityGate abortPipeline: true, credentialsId: 'sonar-creds'
            }
        }
        stage("Docker Images"){
            steps{
                sh "docker build -t saichandu27/phpapp:appimage ."
                sh "docker build -t saichandu27/phpapp:dbimage database"
                
            }
        }
        stage("trivy"){
            steps{
                sh "trivy image saichandu27/phpapp:appimage"
                sh "trivy image saichandu27/phpapp:dbimage"
            }
        }
        stage("docker push"){
            steps{
                script{
                    withDockerRegistry(credentialsId: 'dockerhub-creds') {
                    sh "docker push saichandu27/phpapp:appimage"
                    sh "docker push saichandu27/phpapp:dbimage"

                    }
                }
            }
        }
    }
}
